    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@lezer/highlight": "^1.2.3",
    "@mui/icons-material": "^6.3.0",
    "@mui/material": "^6.3.0",
    "cra-template-typescript": "1.3.0",
    "lucide-react": "^0.469.0",
    "react": "^19.2.8",
    "react-dom": "^19.0.0",
    "react-scripts": "5.0.1"
  },
  "scripts": {
    "fetch-wasm": "node scripts/fetch-wasm.mjs",
    "prestart": "yarn fetch-wasm",
    "prebuild": "yarn fetch-wasm",
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "verify:wasm": "node scripts/verify-wasm-runtime.mjs",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "jest": {
    "transformIgnorePatterns": [
      "[/\\\\]node_modules[/\\\\](?!(@marijn/find-cluster-break)/).+\\.(js|jsx|mjs|cjs|ts|tsx)$",
      "^.+\\.module\\.(css|sass|scss)$"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "~6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/parser": "^8.18.2",
    "autoprefixer": "^10.5.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
